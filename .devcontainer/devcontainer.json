{
  "name": "CloudCode Cloud VPS (Codespace)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableDockerBuildKit": true
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "CloudCode Backend & WebSockets",
      "onAutoForward": "notify",
      "requireLocalPort": false
    }
  },
  "postCreateCommand": "docker build -t cloudcode-base . && cd backend && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
